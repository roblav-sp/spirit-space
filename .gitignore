# Build artifacts (regenerated by ./build.sh)
main.wasm
wasm_exec.js

# Dev-only browser tooling (ADR-0005)
.agents/skills/browser-verify/e2e/node_modules/
.agents/skills/browser-verify/e2e/artifacts/
.agents/skills/browser-verify/e2e/package*.json

# Downloaded asset archives: never committed (ADR-0011).
# Source ZIPs are inputs; the imported, license-reviewed files under
# assets/vendor/** ARE committed deliberately. Do not ignore that path.
*.zip
*:Zone.Identifier
/downloads/

# Interrupted asset imports (should not survive a successful run)
assets/vendor/kenney/*.old/
assets/vendor/kenney/.*.staging/
assets/asset-manifest.json.tmp

# Python dev tooling bytecode (scripts/, not runtime)
__pycache__/
*.py[cod]
